<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      SEC_TUNE N7 (defense-in-depth): character_resources.current_value не должен уходить в минус.
      Все пути записи (modifyResource/restReset/addResource) и так клампят значение в [0, max], так что
      констрейнт лишь фиксирует уже действующий инвариант на уровне БД. Перед добавлением чиним возможные
      грязные строки (UPDATE ... WHERE current_value < 0), иначе ALTER TABLE упадёт на валидации.

      На character_feature_resource CHECK НЕ вешаем: там легальный флаг allow_negative уводит значение
      в минус, а сослаться на колонку соседней таблицы CHECK не может — инвариант неотрицательности там
      держит атомарный условный UPDATE (spendAtomically), а не констрейнт.
    -->
    <changeSet id="116-character-resources-nonnegative" author="claude">
        <sql>UPDATE public.character_resources SET current_value = 0 WHERE current_value &lt; 0</sql>
        <sql>ALTER TABLE public.character_resources
                ADD CONSTRAINT chk_character_resources_nonnegative CHECK (current_value >= 0)</sql>
        <rollback>
            ALTER TABLE public.character_resources DROP CONSTRAINT chk_character_resources_nonnegative
        </rollback>
    </changeSet>

</databaseChangeLog>
